apiVersion: apps/v1
kind: Deployment
metadata:
  name: nginx-preferred-ha
spec:
  replicas: 3
  selector:
    matchLabels:
      app: nginx-preferred-ha
  template:
    metadata:
      labels:
        app: nginx-preferred-ha
    spec:
      affinity:
        podAntiAffinity:
          preferredDuringSchedulingIgnoredDuringExecution:
            - weight: 100
              podAffinityTerm:
                labelSelector:
                  matchLabels:
                    app: nginx-preferred-ha
                topologyKey: kubernetes.io/hostname

      containers:
        - name: nginx
          image: nginx:1.27
          ports:
            - containerPort: 80

          resources:
            requests:
              memory: "64Mi"
              cpu: "250m"   
            limits:
              memory: "128Mi"
              cpu: "500m"